# Copy to ~/.hermes/.env or your deployment environment.
# Do not commit real secrets.

WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=
WECHAT_MP_AUTHOR=
WECHAT_MP_AUTO_PUBLISH=false

# OpenAI-compatible chat endpoint used for article generation.
CONTENT_MODEL_API_KEY=
CONTENT_MODEL_BASE_URL=https://example.com/v1
WECHAT_ARTICLE_MODEL=gpt-5.4-mini

